# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
ENV/
env/

# Pytest & Caches
.pytest_cache/
.coverage
htmlcov/

# SUMO temporary XML network and route files
*.net.xml
*.rou.xml
*.net.xml.bak
*.rou.xml.bak
mock_net.xml
# ...but keep the RESCO benchmark networks (external data, ~1.5MB) so the repo is
# self-contained and does not depend on the upstream RESCO GitHub repo at run time.
!simulator/resco_environments/**/*.net.xml
!simulator/resco_environments/**/*.rou.xml

# Outputs and Plots (kept for local review, but excluded from raw git sync)
outputs/*.csv
outputs/*.png

# Per-seed trained models and cluster logs (regenerated by the sweep)
models/seed*/

# Generated presentation + Office lock files
*.pptx
~$*
# ...but track the final deliverable deck.
!ATLC_MMDP_presentation.pptx

# Editor / System Files
.vscode/
.idea/
.gemini/
.claude/
.DS_Store
Thumbs.db
